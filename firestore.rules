rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appData/{dataKey} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['key', 'value', 'updatedAt'])
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 1000
        && request.resource.data.value is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.value.size() <= 500000;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
